# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so
*.dylib
# Anchored: an unanchored "straw" also matches the C API's public header
# directory C/include/straw/, which excluded straw.h from the repository and
# left a clean checkout unable to build the C API.
/straw
/C++/straw

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Emacs files #
###############
*~

# R files #
###########
.R*

# PyPi bins #
#############
dist
env
hic_straw.egg-info

.Rproj.user
/C++/build
/run
/tools
/C++/build-v10
*.hic
*.pyc
/benchmarks
# Keep the reproducible loop-latency suite in version control, but never its
# generated plans, timing tables, or plots.
!/benchmarks/
/benchmarks/*
!/benchmarks/loop_latency/
!/benchmarks/loop_latency/**
/benchmarks/loop_latency/output/
/benchmarks/loop_latency/__pycache__/
/C++/build-loop-latency/
/.venv-loop-latency/
/benchmarks/loop_latency/.DS_Store
